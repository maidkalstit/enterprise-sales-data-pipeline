FROM apache/airflow:2.9.1-python3.11

USER root
# Cài đặt lệnh Docker CLI vào hệ điều hành của Airflow
RUN apt-get update && \
    apt-get install -y docker.io && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow
# Airflow không chạy python nghiệp vụ: mọi job đều chạy trong Spark container qua
# docker exec (DAG dùng BashOperator) — chỉ cần Docker CLI đã cài phía trên.