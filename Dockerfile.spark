# Spark runtime image — bake sẵn dependency (pin version) vào image,
# KHÔNG pip install lúc start container (tránh phụ thuộc mạng + không tái lập được).
FROM apache/spark:3.5.0

USER root
RUN pip install --no-cache-dir \
    requests==2.33.1 \
    python-dotenv==1.2.2 \
    psycopg2-binary==2.9.10 \
    pandas==2.2.3 \
    faker==40.15.0 \
    kafka-python==2.3.1
